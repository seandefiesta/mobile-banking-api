{
  "name": "mobile-banking-api",
  "version": "1.0.0",
  "description": "A local REST API for a mobile banking app: auth, accounts, deposits, withdrawals and transfers.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "node --test --no-warnings \"test/*.test.js\""
  },
  "engines": {
    "node": ">=22.13"
  },
  "keywords": ["banking", "rest-api", "jwt", "sqlite", "nodejs"],
  "license": "MIT"
}
